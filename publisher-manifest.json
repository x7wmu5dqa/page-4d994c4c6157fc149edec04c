55,.05);border:1px solid rgba(238,244,249,.14);border-radius:22px;padding:28px 26px}\n.faq-group > h3{font-size:13px;letter-spacing:.22em;text-transform:uppercase;color:var(--amber);margin-bottom:20px}\n.qa + .qa{margin-top:20px;padding-top:20px;border-top:1px solid rgba(238,244,249,.12)}\n.qa h4{font-size:16px;margin:0 0 8px;color:#fff}\n.qa p{font-size:15px;color:rgba(238,244,249,.76)}\n\n/* 页脚 */\nfooter{background:var(--deep-2);color:rgba(238,244,249,.7);padding:44px 0 52px;font-size:14px}\n.foot{display:flex;flex-wrap:wrap;gap:20px;justify-content:space-between;align-items:baseline}\n.foot strong{color:var(--amber);letter-spacing:.3em;font-size:14px}\n.foot a{text-decoration:none;border-bottom:1px solid rgba(238,244,249,.3)}\n.foot a:hover{border-color:var(--amber);color:#fff}\n\n@media (max-width:820px){\n  .hero-inner{grid-template-columns:1fr;padding:48px 0 64px}\n  .hero-col{max-width:none}\n  section{padding:60px 0}\n  .how{grid-template-columns:1fr;gap:32px}\n  .clients{grid-template-columns:1fr}\n  .plan:nth-child(2),.plan:nth-child(3){margin-left:0}\n  .step{grid-template-columns:1fr;gap:14px;padding:22px}\n}\n</style><header class=\"hero\" id=\"top\">\n  <div class=\"wrap hero-inner\">\n    <div></div>\n    <div class=\"hero-col\">\n      <div class=\"brand-line\">\n        <span class=\"brand-mark\">HEY</span>\n        <span class=\"brand-sub\">订阅 / 客户端 / 说明</span>\n      </div>\n      <h1>\n        HEY，把选择说清楚\n        <span class=\"thin\">三档订阅阶梯递进。读完这一页，你就知道自己该站在哪一级。</span>\n      </h1>\n      <p class=\"hero-text\">我们不做堆砌卖点的长页。每档套餐给多少流量、能连几台设备、用哪类节点，都写在明面上。</p>\n      <p class=\"hero-text\">下面是使用步骤、套餐对照和常见问题。按顺序读，或者直接跳到你关心的部分。</p>\n      <p class=\"hero-note\">页面内容为品牌信息说明，不构成任何服务承诺。价格与权益以下方套餐区为准。</p>\n      <nav class=\"anchors\" aria-label=\"页内导航\">\n        <a href=\"#how\" class=\"primary\">先看怎么用</a>\n        <a href=\"#plans\">套餐对照</a>\n        <a href=\"#clients\">客户端</a>\n        <a href=\"#faq\">常见问题</a>\n      </nav>\n    </div>\n  </div>\n</header>\n\n<main>\n\n  <section id=\"how\">\n    <div class=\"wrap how\">\n      <div>\n        <p class=\"eyebrow\">使用说明</p>\n        <h2>四步走完，知道自己该选什么</h2>\n        <p class=\"lead\">先看步骤，再看套餐。顺序反了容易只盯着价格，忽略设备数这一项。</p>\n      </div>\n      <div class=\"steps\">\n        <article class=\"step\">\n          <div class=\"step-no\">01</div>\n          <div>\n            <h3>先数设备</h3>\n            <p>手机、平板、笔记本各算一台。把同时会连线的设备数量写下来，这是选档的第一道筛子。</p>\n          </div>\n        </article>\n        <article class=\"step\">\n          <div class=\"step-no\">02</div>\n          <div>\n            <h3>再估流量</h3>\n            <p>只读网页和收发消息，和每天看视频，是两个量级。按过去一个月最忙的那周估，别按最闲的估。</p>\n          </div>\n        </article>\n        <article class=\"step\">\n          <div class=\"step-no\">03</div>\n          <div>\n            <h3>对照套餐</h3>\n            <p>基础版、旗舰版、团队版逐级递进。设备数和流量同时满足的一档，就是你要的那一档。</p>\n          </div>\n        </article>\n        <article class=\"step\">\n          <div class=\"step-no\">04</div>\n          <div>\n            <h3>装好客户端</h3>\n            <p>按设备类型看客户端区块的说明，确认系统与版本要求，再决定装哪一份。</p>\n          </div>\n        </article>\n      </div>\n    </div>\n  </section>\n\n  <hr class=\"rule\">\n\n  <section id=\"plans\" class=\"plans\">\n    <div class=\"wrap\">\n      <div class=\"plans-head\">\n        <p class=\"eyebrow\">套餐</p>\n        <h2>从基础到团队，逐级递进</h2>\n        <p class=\"lead\">每一档都在上一档的基础上加设备数、加流量、加节点类型。没有隐藏档位，也没有需要打电话问的报价。</p>\n      </div>\n\n      <div class=\"stair\">\n        <article class=\"plan\">\n          <div class=\"plan-top\">\n            <h3 class=\"plan-name\">基础版</h3>\n          </div>\n          <p class=\"price\">¥15<span>/ 月</span></p>\n          <p class=\"annual\">按年付 ¥150 / 年</p>\n          <ul>\n            <li>每月 100GB 流量</li>\n            <li>3 台设备同时在线</li>\n            <li>基础流媒体解锁</li>\n            <li>普通线路节点池</li>\n          </ul>\n          <p class=\"plan-foot\">适合个人、设备少、以阅读和日常浏览为主的使用者。</p>\n        </article>\n\n        <article class=\"plan featured\">\n          <div class=\"plan-top\">\n            <h3 class=\"plan-name\">旗舰版</h3>\n            <span class=\"badge\">多数人选这档</span>\n          </div>\n          <p class=\"price\">¥35<span>/ 月</span></p>\n          <p class=\"annual\">按年付 ¥350 / 年</p>\n          <ul>\n            <li>每月 300GB 流量</li>\n            <li>5 台设备同时在线</li>\n            <li>全节点原生流媒体解锁</li>\n            <li>IPLC 专线游戏加速优化</li>\n            <li>7x24 优先工单支持</li>\n          </ul>\n          <p class=\"plan-foot\">适合多设备、看视频，并需要优先响应的个人用户。</p>\n        </article>\n\n        <article class=\"plan\">\n          <div class=\"plan-top\">\n            <h3 class=\"plan-name\">团队版</h3>\n          </div>\n          <p class=\"price\">¥85<span>/ 月</span></p>\n          <p class=\"annual\">按年付 ¥850 / 年</p>\n          <ul>\n            <li>每月 1000GB 流量</li>\n            <li>20 台设备同时在线</li>\n            <li>VIP 专属高带宽节点</li>\n            <li>支持企业定制路由</li>\n            <li>专属客户经理服务</li>\n          </ul>\n          <p class=\"plan-foot\">适合多人共用、需要统一管理与定制路由的小团队。</p>\n        </article>\n      </div>\n    </div>\n  </section>\n\n  <section id=\"clients\">\n    <div class=\"wrap\">\n      <p class=\"eyebrow\">客户端</p>\n      <h2>按设备挑，不按习惯挑</h2>\n      <p class=\"lead\">同一个账号可以在不同设备上使用。先确认系统版本，再考虑界面顺手不顺手。</p>\n      <div class=\"clients\">\n        <article class=\"client\">\n          <h3>桌面端</h3>\n          <p>适用于日常办公与长时段使用。安装前确认系统版本，装好后用订阅信息完成配置即可。</p>\n          <p class=\"tagline\">建议在稳定网络下首次配置</p>\n        </article>\n        <article class=\"client\">\n          <h3>移动端</h3>\n          <p>适用于手机与平板。移动网络切换较频繁时，建议保留一份备用配置，避免临时中断。</p>\n          <p class=\"tagline\">注意同时在线设备数上限</p>\n        </article>\n        <article class=\"client\">\n          <h3>路由器与其他设备</h3>\n          <p>团队版支持企业定制路由。个人用户如需在路由器上部署，请先确认设备性能与固件情况。</p>\n          <p class=\"tagline\">配置前请阅读设备自带说明</p>\n        </article>\n        <article class=\"client\">\n          <h3>下载与版本</h3>\n          <p>客户端安装包与版本更新信息以官方渠道公布为准。本页不提供下载地址，避免出现来源不明的文件。</p>\n          <p class=\"tagline\">请核对来源后再安装</p>\n        </article>\n      </div>\n    </div>\n  </section>\n\n  <section id=\"faq\" class=\"faq\">\n    <div class=\"wrap\">\n      <p class=\"eyebrow\">常见问题</p>\n      <h2>按主题分组，先找你的那一组</h2>\n      <p class=\"lead\">问题分三类：选档、计费、使用。没找到答案的，可以走工单。</p>\n\n      <div class=\"faq-groups\">\n        <article class=\"faq-group\">\n          <h3>选档与套餐</h3>\n          <div class=\"qa\">\n            <h4>基础版和旗舰版差在哪？</h4>\n            <p>主要是三点：流量从 100GB 到 300GB，设备从 3 台到 5 台，节点从普通线路池变成全节点原生流媒体解锁，并增加 IPLC 专线游戏加速优化与优先工单支持。</p>\n          </div>\n          <div class=\"qa\">\n            <h4>什么时候该升级到团队版？</h4>\n            <p>当同时在线设备接近 5 台，或者每月流量经常用满 300GB 时，团队版的 20 台设备与 1000GB 流量更合适，另外还包含定制路由和专属客户经理。</p>\n          </div>\n          <div class=\"qa\">\n            <h4>可以中途换档吗？</h4>\n            <p>套餐档位之间可以按需调整。具体生效时间与费用差额，请以购买页面的说明或工单答复为准。</p>\n          </div>\n        </article>\n\n        <article class=\"faq-group\">\n          <h3>计费与年付</h3>\n          <div class=\"qa\">\n            <h4>年付比月付省多少？</h4>\n            <p>三档年付都是十个月的价格：基础版 ¥150、旗舰版 ¥350、团队版 ¥850，分别对应每月 ¥15、¥35、¥85 的月付价。</p>\n          </div>\n          <div class=\"qa\">\n            <h4>流量按月清零吗？</h4>\n            <p>套餐中的流量按月度周期计算。当期未用完的额度不结转到下一周期，建议按实际使用量选档。</p>\n          </div>\n          <div class=\"qa\">\n            <h4>有没有试用？</h4>\n            <p>本页未列出试用安排。如需了解，请通过工单或官方渠道确认当期政策，不要依据本页推测。</p>\n          </div>\n        </article>\n\n        <article class=\"faq-group\">\n          <h3>使用与客户端</h3>\n          <div class=\"qa\">\n            <h4>同时在线设备怎么算？</h4>\n            <p>同一时间保持连线的设备计入在线数。不同时使用的设备可以退出后再连，不占用当期名额。</p>\n          </div>\n          <div class=\"qa\">\n            <h4>客户端从哪里获取？</h4>\n            <p>请以官方渠道公布的安装包为准。本页只说明客户端分类与注意事项，不提供下载链接。</p>\n          </div>\n          <div class=\"qa\">\n            <h4>遇到问题找谁？</h4>\n            <p>旗舰版含 7x24 优先工单支持，团队版另有专属客户经理。基础版用户可通过常规工单渠道提交问题。</p>\n          </div>\n        </article>\n      </div>\n    </div>\n  </section>\n\n</main>\n\n<footer>\n  <div class=\"wrap foot\">\n    <strong>HEY</strong>\n    <span>页面价格与权益为展示信息，购买前请以官方渠道为准。</span>\n    <a href=\"#top\">回到顶部</a>\n  </div>\n</footer>",
